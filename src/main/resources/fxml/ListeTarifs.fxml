<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projet7.controller.ListeTarifsController"
            prefHeight="600.0" prefWidth="750.0">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Liste des tarifs">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Rechercher (diplôme ou n° tarif) :"/>
                <TextField fx:id="txtRecherche" promptText="Diplôme ou num_tarif..." prefWidth="220"/>
                <Button fx:id="btnRechercher" text="Rechercher" onAction="#onRechercher"/>
                <Button fx:id="btnReinitialiser" text="Réinitialiser" onAction="#onReinitialiser"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnAjouter" text="Ajouter" onAction="#onAjouter"/>
                <Button fx:id="btnModifier" text="Modifier" onAction="#onModifier"/>
                <Button fx:id="btnSupprimer" text="Supprimer" onAction="#onSupprimer"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableTarifs">
            <columns>
                <TableColumn fx:id="colNumTarif" text="N° Tarif" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="numTarif"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDiplome" text="Diplôme" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="diplome"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="categorie"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colMontant" text="Montant (Ar)" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="montant"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>
            <Label fx:id="lblTotal" text="Nombre de tarifs : 0"/>
        </HBox>
    </bottom>

</BorderPane>
